<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FitBody" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.SplashScreen.FitBody" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, animated icon, and animation
        duration. -->
        <item name="windowSplashScreenBackground">@color/color_fit_background</item>

        <!-- Use windowSplashScreenAnimatedIcon to add a drawable or an animated
             drawable. One of these is required. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo</item>
        <!-- Required for animated icons. -->
        <!-- <item name="windowSplashScreenAnimationDuration">200</item> -->

        <!-- Set the theme of the Activity that directly follows your splash
        screen. This is required. -->
        <item name="postSplashScreenTheme">@style/Theme.FitBody</item>
    </style>
</resources>